---
// AnnualCalculator.astro
---
<div class="calculator-card">
    <div class="input-column">
        <div class="input-row">
            <label for="dailyCommute">Commute</label>
            <div class="input-wrapper">
                <input type="number" id="dailyCommute" placeholder="e.g. 30">
                <select class="dropdown-unit"><option>miles</option><option>km</option></select>
            </div>
        </div>

        <div class="input-row">
            <label for="daysPerWeek">Work Days</label>
            <div class="input-wrapper">
                <input type="number" id="daysPerWeek" placeholder="e.g. 5" max="7">
                <select class="dropdown-unit"><option>days/wk</option></select>
            </div>
        </div>

        <div class="input-row">
            <label for="weekendMiles">Weekend</label>
            <div class="input-wrapper">
                <input type="number" id="weekendMiles" placeholder="e.g. 50">
                <select class="dropdown-unit"><option>miles</option><option>km</option></select>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn" id="calcAnnualBtn">Calculate</button>
            <button class="btn" id="resetAnnualBtn">Reset</button>
        </div>
    </div>

    <div class="output-column">
        <table class="result-table">
            <thead>
                <tr>
                    <th>Units</th>
                    <th>Output</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Weekly Work Commute</td>
                    <td id="out-work">-</td>
                </tr>
                <tr>
                    <td>Weekly Total</td>
                    <td id="out-weekly">-</td>
                </tr>
            </tbody>
        </table>
        
        <div class="final-result" id="out-annual">
            Annual: 0
        </div>
    </div>
</div>

<script>
    const commuteInput = document.getElementById('dailyCommute') as HTMLInputElement;
    const daysInput = document.getElementById('daysPerWeek') as HTMLInputElement;
    const weekendInput = document.getElementById('weekendMiles') as HTMLInputElement;

    document.getElementById('calcAnnualBtn')?.addEventListener('click', () => {
        const commute = parseFloat(commuteInput.value) || 0;
        const days = parseFloat(daysInput.value) || 0;
        const weekend = parseFloat(weekendInput.value) || 0;
        
        const workMiles = commute * days;
        const weeklyMiles = workMiles + weekend;
        const annualMiles = weeklyMiles * 52;
        
        document.getElementById('out-work')!.innerText = workMiles > 0 ? workMiles.toString() : '-';
        document.getElementById('out-weekly')!.innerText = weeklyMiles > 0 ? weeklyMiles.toString() : '-';
        document.getElementById('out-annual')!.innerText = `Annual: ${annualMiles.toLocaleString()}`;
    });

    document.getElementById('resetAnnualBtn')?.addEventListener('click', () => {
        commuteInput.value = '';
        daysInput.value = '';
        weekendInput.value = '';
        document.getElementById('out-work')!.innerText = '-';
        document.getElementById('out-weekly')!.innerText = '-';
        document.getElementById('out-annual')!.innerText = 'Annual: 0';
    });
</script>

---
// GasCalculator.astro - Comprehensive Mileage Calculator
---
<div class="calculator-card">
    <div class="input-column">
        <div class="input-row">
            <label>Distance</label>
            <div class="input-wrapper">
                <input type="number" id="distance" placeholder="e.g. 360">
                <div class="toggle-group">
                    <button id="dist-km" class="active">km</button>
                    <button id="dist-miles">miles</button>
                </div>
            </div>
        </div>

        <div class="input-row">
            <label>Fuel</label>
            <div class="input-wrapper">
                <input type="number" id="fuel" placeholder="e.g. 7">
                <div class="toggle-group">
                    <button id="fuel-ltr" class="active">Ltr</button>
                    <button id="fuel-gal">Gal</button>
                </div>
            </div>
        </div>

        <div class="input-row">
            <label>Fuel Price</label>
            <div class="input-wrapper">
                <input type="number" id="price" placeholder="e.g. 104.83" step="0.01">
                <select class="dropdown-unit" id="currency">
                    <option value="₹" data-price="102.12">INR ₹</option>
                    <option value="$" data-price="1.11">USD $</option>
                    <option value="€" data-price="1.81">EUR €</option>
                    <option value="£" data-price="1.50">GBP £</option>
                    <option value="A$" data-price="2.05">AUD A$</option>
                    <option value="C$" data-price="1.72">CAD C$</option>
                    <option value="¥" data-price="169.20">JPY ¥</option>
                    <option value="د.إ" data-price="3.83">AED د.إ</option>
                    <option value="S$" data-price="3.08">SGD S$</option>
                    <option value="R$" data-price="6.62">BRL R$</option>
                </select>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn" id="calcBtn">Calculate</button>
            <button class="btn btn-secondary" id="resetBtn">Reset</button>
        </div>
    </div>

    <div class="output-column">
        <table class="result-table">
            <thead>
                <tr><th>Metric</th><th>Output</th></tr>
            </thead>
            <tbody>
                <tr><td>Distance (km)</td><td id="out-km">-</td></tr>
                <tr><td>Distance (miles)</td><td id="out-miles">-</td></tr>
                <tr><td>Fuel (Litres)</td><td id="out-ltr">-</td></tr>
                <tr><td>Fuel (Gallons)</td><td id="out-gal">-</td></tr>
                <tr><td>Total Fuel Cost</td><td id="out-total">-</td></tr>
                <tr class="highlight-row"><td>Mileage (kmpl)</td><td id="out-kmpl">-</td></tr>
                <tr class="highlight-row"><td>Mileage (mpg)</td><td id="out-mpg">-</td></tr>
                <tr><td>Cost per Kilometer</td><td id="out-cpk">-</td></tr>
                <tr><td>Cost per Mile</td><td id="out-cpm">-</td></tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    const KM_TO_MILES = 0.621371;
    const MILES_TO_KM = 1.60934;
    const LTR_TO_GAL = 0.264172;
    const GAL_TO_LTR = 3.78541;

    const distInput = document.getElementById('distance') as HTMLInputElement;
    const fuelInput = document.getElementById('fuel') as HTMLInputElement;
    const priceInput = document.getElementById('price') as HTMLInputElement;
    const currencySelect = document.getElementById('currency') as HTMLSelectElement;

    let distUnit = 'km';
    let fuelUnit = 'Ltr';

    // Autofill fuel price on currency change
    currencySelect?.addEventListener('change', () => {
        const selected = currencySelect.options[currencySelect.selectedIndex];
        const price = selected.getAttribute('data-price');
        if (price) priceInput.value = price;
    });
    // Autofill on page load
    const initOption = currencySelect?.options[currencySelect.selectedIndex];
    if (initOption && !priceInput.value) priceInput.value = initOption.getAttribute('data-price') || '';

    // Toggle logic
    function setupToggle(btnIds: string[], callback: (unit: string) => void) {
        const btns = btnIds.map(id => document.getElementById(id));
        btns.forEach(btn => {
            btn?.addEventListener('click', () => {
                btns.forEach(b => b?.classList.remove('active'));
                btn.classList.add('active');
                callback(btn.textContent!.trim());
            });
        });
    }

    setupToggle(['dist-km', 'dist-miles'], (u) => distUnit = u === 'km' ? 'km' : 'miles');
    setupToggle(['fuel-ltr', 'fuel-gal'], (u) => fuelUnit = u === 'Ltr' ? 'Ltr' : 'Gal');

    document.getElementById('calcBtn')?.addEventListener('click', () => {
        const rawDist = parseFloat(distInput.value);
        const rawFuel = parseFloat(fuelInput.value);
        const price = parseFloat(priceInput.value) || 0;
        const sym = currencySelect.value;

        if (isNaN(rawDist) || isNaN(rawFuel) || rawFuel <= 0 || rawDist <= 0) return;

        // Normalize to km and litres
        const distKm = distUnit === 'km' ? rawDist : rawDist * MILES_TO_KM;
        const distMi = distUnit === 'miles' ? rawDist : rawDist * KM_TO_MILES;
        const fuelLtr = fuelUnit === 'Ltr' ? rawFuel : rawFuel * GAL_TO_LTR;
        const fuelGal = fuelUnit === 'Gal' ? rawFuel : rawFuel * LTR_TO_GAL;

        // Mileage
        const kmpl = distKm / fuelLtr;
        const mpg = distMi / fuelGal;

        // Cost
        // Price is always "per unit of fuel as entered"
        const pricePerLtr = fuelUnit === 'Ltr' ? price : price / GAL_TO_LTR;
        const totalCost = fuelLtr * pricePerLtr;
        const costPerKm = totalCost / distKm;
        const costPerMi = totalCost / distMi;

        document.getElementById('out-km')!.textContent = distKm.toFixed(2) + ' km';
        document.getElementById('out-miles')!.textContent = distMi.toFixed(2) + ' miles';
        document.getElementById('out-ltr')!.textContent = fuelLtr.toFixed(2) + ' L';
        document.getElementById('out-gal')!.textContent = fuelGal.toFixed(2) + ' gal';
        document.getElementById('out-total')!.textContent = price > 0 ? sym + totalCost.toFixed(2) : '-';
        document.getElementById('out-kmpl')!.textContent = kmpl.toFixed(2) + ' kmpl';
        document.getElementById('out-mpg')!.textContent = mpg.toFixed(2) + ' mpg';
        document.getElementById('out-cpk')!.textContent = price > 0 ? sym + costPerKm.toFixed(2) : '-';
        document.getElementById('out-cpm')!.textContent = price > 0 ? sym + costPerMi.toFixed(2) : '-';
    });

    document.getElementById('resetBtn')?.addEventListener('click', () => {
        distInput.value = ''; fuelInput.value = ''; priceInput.value = '';
        ['out-km','out-miles','out-ltr','out-gal','out-total','out-kmpl','out-mpg','out-cpk','out-cpm'].forEach(id => {
            document.getElementById(id)!.textContent = '-';
        });
    });
</script>

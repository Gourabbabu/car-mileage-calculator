---
---
<div class="glass-card">
  <div class="tabs">
    <button class="tab active" data-tab="mpg">Gas Mileage</button>
    <button class="tab" data-tab="annual">Annual Mileage</button>
    <button class="tab" data-tab="reimburse">Reimbursement</button>
  </div>

  <div id="mpg-content" class="tab-content active">
    <h2>Calculate Your MPG</h2>
    <form id="mpgForm">
      <div class="form-group">
        <label for="startOdo">Starting Odometer (miles)</label>
        <input type="number" id="startOdo" placeholder="e.g. 50000" required step="any" min="0">
      </div>
      <div class="form-group">
        <label for="endOdo">Ending Odometer (miles)</label>
        <input type="number" id="endOdo" placeholder="e.g. 50350" required step="any" min="0">
      </div>
      <div class="form-group">
        <label for="fuelAdded">Fuel Added (gallons)</label>
        <input type="number" id="fuelAdded" placeholder="e.g. 14.5" required step="any" min="0.1">
      </div>
      <div class="form-group">
        <label for="pricePerGal">Price per Gallon ($) (Optional)</label>
        <input type="number" id="pricePerGal" placeholder="e.g. 3.50" step="any" min="0">
      </div>
      <button type="submit" class="btn">Calculate Mileage</button>
    </form>
    <div id="mpgResults" class="results">
      <div class="result-item">
        <span>Miles Driven:</span>
        <span id="resMiles" class="result-value">-</span>
      </div>
      <div class="result-item">
        <span>Gas Mileage (MPG):</span>
        <span id="resMpg" class="result-value">-</span>
      </div>
      <div class="result-item" id="costResult" style="display:none;">
        <span>Cost per Mile:</span>
        <span id="resCost" class="result-value">-</span>
      </div>
    </div>
  </div>

  <div id="annual-content" class="tab-content">
    <h2>Annual Mileage Calculator</h2>
    <form id="annualForm">
      <div class="form-group">
        <label for="dailyMiles">Average Daily Commute (miles)</label>
        <input type="number" id="dailyMiles" placeholder="e.g. 30" required step="any" min="0">
      </div>
      <div class="form-group">
        <label for="weekendMiles">Average Weekend Driving (miles)</label>
        <input type="number" id="weekendMiles" placeholder="e.g. 50" required step="any" min="0">
      </div>
      <div class="form-group">
        <label for="vacationMiles">Estimated Vacation/Road Trip (miles/year)</label>
        <input type="number" id="vacationMiles" placeholder="e.g. 1000" step="any" min="0">
      </div>
      <button type="submit" class="btn">Calculate Annual Mileage</button>
    </form>
    <div id="annualResults" class="results">
      <div class="result-item">
        <span>Total Annual Mileage:</span>
        <span id="resAnnual" class="result-value">-</span>
      </div>
    </div>
  </div>

  <div id="reimburse-content" class="tab-content">
    <h2>Mileage Calculator Reimbursement</h2>
    <form id="reimburseForm">
      <div class="form-group">
        <label for="businessMiles">Business Miles Driven</label>
        <input type="number" id="businessMiles" placeholder="e.g. 120" required step="any" min="0">
      </div>
      <div class="form-group">
        <label for="ratePerMile">Reimbursement Rate ($/mile)</label>
        <input type="number" id="ratePerMile" value="0.67" required step="any" min="0">
        <small style="display:block;margin-top:0.25rem;opacity:0.7;">Default: 2024 IRS Standard Rate ($0.67)</small>
      </div>
      <button type="submit" class="btn">Calculate Reimbursement</button>
    </form>
    <div id="reimburseResults" class="results">
      <div class="result-item">
        <span>Total Reimbursement:</span>
        <span id="resReimburse" class="result-value">-</span>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab Switching
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(tab.dataset.tab + '-content').classList.add('active');
    });
  });

  // MPG Calculation
  document.getElementById('mpgForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const start = parseFloat(document.getElementById('startOdo').value);
    const end = parseFloat(document.getElementById('endOdo').value);
    const fuel = parseFloat(document.getElementById('fuelAdded').value);
    const price = parseFloat(document.getElementById('pricePerGal').value);

    if (end <= start) {
      alert("Ending odometer must be greater than starting odometer.");
      return;
    }

    const miles = end - start;
    const mpg = miles / fuel;

    document.getElementById('resMiles').innerText = miles.toLocaleString() + ' mi';
    document.getElementById('resMpg').innerText = mpg.toFixed(2) + ' MPG';

    if (!isNaN(price) && price > 0) {
      const totalCost = fuel * price;
      const costPerMile = totalCost / miles;
      document.getElementById('resCost').innerText = '$' + costPerMile.toFixed(2);
      document.getElementById('costResult').style.display = 'flex';
    } else {
      document.getElementById('costResult').style.display = 'none';
    }

    document.getElementById('mpgResults').classList.add('show');
  });

  // Annual Calculation
  document.getElementById('annualForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const daily = parseFloat(document.getElementById('dailyMiles').value) || 0;
    const weekend = parseFloat(document.getElementById('weekendMiles').value) || 0;
    const vacation = parseFloat(document.getElementById('vacationMiles').value) || 0;

    const annual = ((daily * 5) + weekend) * 52 + vacation;

    document.getElementById('resAnnual').innerText = annual.toLocaleString() + ' mi/yr';
    document.getElementById('annualResults').classList.add('show');
  });

  // Reimbursement Calculation
  document.getElementById('reimburseForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const miles = parseFloat(document.getElementById('businessMiles').value) || 0;
    const rate = parseFloat(document.getElementById('ratePerMile').value) || 0;

    const reimbursement = miles * rate;

    document.getElementById('resReimburse').innerText = '$' + reimbursement.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
    document.getElementById('reimburseResults').classList.add('show');
  });
</script>

---
// ReimbursementCalculator.astro
---
<div class="calculator-card">
    <div class="input-column">
        <div class="input-row">
            <label for="businessMiles">Distance</label>
            <div class="input-wrapper">
                <input type="number" id="businessMiles" placeholder="e.g. 150">
                <select class="dropdown-unit"><option>miles</option><option>km</option></select>
            </div>
        </div>

        <div class="input-row">
            <label for="reimbursementRate">Rate</label>
            <div class="input-wrapper">
                <input type="number" id="reimbursementRate" placeholder="e.g. 0.67" step="0.01">
                <select class="dropdown-unit"><option>$/mile</option></select>
            </div>
        </div>

        <div class="action-buttons">
            <button class="btn" id="calcReimbBtn">Calculate</button>
            <button class="btn" id="resetReimbBtn">Reset</button>
        </div>
    </div>

    <div class="output-column">
        <table class="result-table">
            <thead>
                <tr>
                    <th>Units</th>
                    <th>Output</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Business Distance</td>
                    <td id="out-reimb-dist">-</td>
                </tr>
                <tr>
                    <td>Rate Applied</td>
                    <td id="out-rate">-</td>
                </tr>
            </tbody>
        </table>
        
        <div class="final-result" id="out-reimb-total">
            Total: $0.00
        </div>
    </div>
</div>

<script>
    const milesInput = document.getElementById('businessMiles') as HTMLInputElement;
    const rateInput = document.getElementById('reimbursementRate') as HTMLInputElement;

    document.getElementById('calcReimbBtn')?.addEventListener('click', () => {
        const miles = parseFloat(milesInput.value);
        const rate = parseFloat(rateInput.value);
        
        if (!isNaN(miles) && !isNaN(rate) && miles >= 0 && rate >= 0) {
            document.getElementById('out-reimb-dist')!.innerText = miles.toString();
            document.getElementById('out-rate')!.innerText = rate.toString();
            
            const total = miles * rate;
            document.getElementById('out-reimb-total')!.innerText = `Total: $${total.toFixed(2)}`;
        }
    });

    document.getElementById('resetReimbBtn')?.addEventListener('click', () => {
        milesInput.value = '';
        rateInput.value = '';
        document.getElementById('out-reimb-dist')!.innerText = '-';
        document.getElementById('out-rate')!.innerText = '-';
        document.getElementById('out-reimb-total')!.innerText = 'Total: $0.00';
    });
</script>
